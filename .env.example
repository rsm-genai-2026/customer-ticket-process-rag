# Copy this file to `.env` and fill in your own API key
# The real `.env` is gitignored and flagged by the secret-scan hook if you try to commit it
#
# Your TritonAI API key should be listed on the page below for your class:
# https://rsm-django-02.ucsd.edu/mgt449/resources/links/
# https://rsm-django-02.ucsd.edu/mgta495/resources/links/

TRITONAI_API_KEY=your-key-here

# Optional: load the FAQ knowledge base from a remote database (Postgres,
# MySQL, SQLite, …) instead of data/raw/faq_knowledge_base.csv.
# When this is set, the check-faq-resolution skill AND the MCP data server's
# faq://kb resource both read from the URI via polars.read_database_uri.
# When unset, both fall back to the local CSV.
#
# FAQ_KB_URI=postgresql://team_default:PASSWORD@host.example.com:5432/genai4biz_data?options=-csearch_path%3Dteam_default

